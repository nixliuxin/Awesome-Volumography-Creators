{
  "name": "awesome-volumography-creators",
  "version": "1.0.0",
  "description": "A curated list of 3D/4D scanning artists",
  "scripts": {
    "dev": "npm run manifest && npx vite",
    "build": "npm run manifest && npx vite build && npm run optimize-images && npm run copy-data",
    "copy-data": "node -e \"require('fs').cpSync('website/data','dist/data',{recursive:true})\"",
    "optimize-images": "node scripts/optimize-images.js",
    "preview": "npx vite preview",
    "manifest": "node scripts/generate-manifest.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.0"
  }
}
