{
  "name": "awesome-volumography-creators",
  "version": "1.0.0",
  "description": "Curated gallery of the world's best Gaussian Splatting, NeRF & 3D/4D capture artists. The Volumography movement.",
  "scripts": {
    "dev": "npm run manifest && npx vite",
    "build": "npm run manifest && npx vite build && npm run optimize-images && npm run copy-data",
    "copy-data": "node -e \"const fs=require('fs'); fs.cpSync('website/data','website/dist/data',{recursive:true}); fs.cpSync('website/assets/og-image.jpg','website/dist/assets/og-image.jpg');\"",
    "optimize-images": "node scripts/optimize-images.js",
    "preview": "npx vite preview",
    "manifest": "node scripts/generate-manifest.js",
    "card": "node _dev/social-cards/generate.mjs",
    "card:preview": "npx serve _dev/social-cards -l 3210"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.18",
    "marked": "^17.0.2",
    "postcss": "^8.4.35",
    "puppeteer": "^24.37.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.0"
  }
}
